; templates/named.conf.local.j2
zone "." IN {
    type hint;
    file "named.ca";

};

zone "{{ domain_name }}" IN {
    type master;
    file "{{ domain_name }}.forward";
    allow-update { none; }; 
};

zone "{{ reverse_net }}.in-addr.arpa" IN {
    type master;
    file "{{ domain_name }}.reverse";
    allow-update { none; };


};

#include "/etc/named.rfc1912.zones";
#include "/etc/named.root.key";

