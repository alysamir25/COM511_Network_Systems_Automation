UI syslinux/vesamenu.c32
DEFAULT Pxeboot Ubuntu
PROMPT 0

MENU INCLUDE syslinux/graphics.conf

TIMEOUT 100

LABEL Pxeboot Ubuntu http
    MENU LABEL Install Ubuntu 24 from pxe http
    KERNEL /ubuntu/vmlinuz
    INITRD /ubuntu/initrd
    SYSAPPEND 3
    APPEND  url=http://192.168.0.254:8080/sharedisos/ubuntu-24.04.5-live-server-amd64.iso cloud-config-url=/dev/null autoinstall  ds=nocloud-net;s=http://192.168.0.254:8080/cloud-init/ubuntu/24.04/conf/default fsck.mode=skip
            
LABEL Pxeboot Ubuntu nfs
    MENU LABEL Install Ubuntu 24 from NFS pxe
    KERNEL /ubuntu/vmlinuz
    INITRD /ubuntu/initrd
    SYSAPPEND 3
    APPEND  boot=casper netboot=nfs nfsroot=192.168.0.254:/srv/nfs/pxe/ubuntu/iso cloud-config-url=/dev/null autoinstall  ds=nocloud-net;s=http://192.168.0.254:8080/cloud-init/ubuntu/24.04/conf/default fsck.mode=skip
  
LABEL Local Boot
    KERNEL syslinux/chain.c32
    APPEND hd0

